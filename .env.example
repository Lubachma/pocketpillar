# Server
PORT=3000
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=debug

# Database (local credentials from docker-compose.yml — dev only)
DATABASE_URL=postgresql://pocketpillar:pocketpillar@localhost:5432/pocketpillar

# Redis (local password from docker-compose.yml — dev only)
REDIS_URL=redis://:pocketpillar-dev@localhost:6379

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# CORS (comma-separated origins for production)
CORS_ORIGIN=

# RevenueCat — value shared with the dashboard (webhook Authorization). Empty = webhook disabled.
REVENUECAT_WEBHOOK_AUTH=
