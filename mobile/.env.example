# Flutter app configuration — injected at build time via --dart-define-from-file
# (`make ios` / `make android` targets). Copy this file:
#   cp mobile/.env.example mobile/.env
#
# ⚠️ This file embeds its values into the app's binary: only put
# public keys here. Backend secrets (DATABASE_URL, REDIS_URL,
# SUPABASE_SERVICE_ROLE_KEY...) stay in the root `.env` of the repo —
# NEVER pass the root `.env` as --dart-define-from-file.

# Supabase project URL (Supabase dashboard → Project Settings → API)
SUPABASE_URL=https://your-project.supabase.co

# Public Supabase key (anon / publishable — safe client-side, protected by RLS)
SUPABASE_ANON_KEY=your-anon-key

# Public RevenueCat SDK keys (RevenueCat dashboard → Project → API keys,
# one per platform). EMPTY until the RevenueCat project exists
# (phase 1b-accounts): the app then works entirely for free and
# the paywall shows "purchase unavailable".
REVENUECAT_API_KEY_IOS=
REVENUECAT_API_KEY_ANDROID=
