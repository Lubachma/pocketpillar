<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- Dev uniquement : HTTP clair autorisé vers le backend local
         (10.0.2.2 / localhost) — sinon Android 9+ bloque les appels
         (« Cleartext HTTP traffic not permitted »). La variante release
         (manifeste principal) reste en HTTPS strict. -->
    <application android:usesCleartextTraffic="true"/>
</manifest>
