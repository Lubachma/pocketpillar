{
  "name": "pocketpillar-api",
  "version": "1.0.0",
  "description": "PocketPillar — Swiss pension planning API (2nd/3rd pillar), anchored to official FTA tax data",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/ tests/ vitest.config.ts",
    "lint:fix": "eslint src/ tests/ vitest.config.ts --fix",
    "format": "prettier --write 'src/**/*.ts' 'tests/**/*.ts' 'prisma/**/*.ts' vitest.config.ts",
    "format:check": "prettier --check 'src/**/*.ts' 'tests/**/*.ts' 'prisma/**/*.ts' vitest.config.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev --config prisma/prisma.config.ts",
    "db:studio": "prisma studio --config prisma/prisma.config.ts",
    "db:seed": "tsx prisma/seed.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "PolyForm-Noncommercial-1.0.0",
  "dependencies": {
    "@fastify/cors": "^11.2.0",
    "@fastify/helmet": "^13.0.2",
    "@fastify/multipart": "^9.4.0",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/sensible": "^6.0.4",
    "@fastify/swagger": "^9.7.0",
    "@fastify/swagger-ui": "^6.1.1",
    "@prisma/adapter-pg": "^7.5.0",
    "@prisma/client": "^7.9.1",
    "@supabase/supabase-js": "^2.99.2",
    "dotenv": "^17.3.1",
    "fastify": "^5.8.2",
    "fastify-plugin": "^5.1.0",
    "ioredis": "^5.10.0",
    "pg": "^8.20.0",
    "pino": "^10.3.1",
    "prisma": "^7.9.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.5.0",
    "@types/pg": "^8.18.0",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.0.3",
    "eslint-config-prettier": "^10.1.8",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.8.1",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.57.1",
    "vitest": "^4.1.10"
  }
}
